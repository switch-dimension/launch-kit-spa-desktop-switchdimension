# Copy to .env (in the project root) and fill in. Never commit .env.

# ── Database ────────────────────────────────────────────────────────────────
# Default matches `npm run db:up` (Postgres in Docker, see docker-compose.yml).
# Or paste a Neon / Supabase / other Postgres connection string.
DATABASE_URL=postgresql://launchkit:launchkit@localhost:5433/launchkit

# ── Clerk auth (https://dashboard.clerk.com → API Keys) ────────────────────
# The dashboard shows NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY — copy its value here.
# Used by both the web app and the API.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_
# Secret key — used only by the API to verify sessions. Keep it private.
CLERK_SECRET_KEY=sk_test_
# Optional: PEM public key for networkless token verification
# (Dashboard → API Keys → Show JWT public key). Multi-line values need quotes.
# CLERK_JWT_KEY=

# ── API ─────────────────────────────────────────────────────────────────────
PORT=3834
# Comma-separated origins allowed to call the API (CORS) and whose Clerk
# session tokens are accepted. Defaults to http://localhost:5167.
# Add your production web URL when you deploy.
# ALLOWED_ORIGINS=http://localhost:5167,https://app.example.com

# ── Web ─────────────────────────────────────────────────────────────────────
# API base URL for the frontend. Leave empty for same-origin (Vite proxy in dev).
# Set it for production if the API is on a different host (and for desktop builds).
VITE_API_URL=
